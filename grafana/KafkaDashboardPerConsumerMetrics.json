  "panels": [
    {
      "id": 1,
      "title": "System total lag",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((consumer_lag{run_id=\"$run_id\"} and (consumer_lag_valid{run_id=\"$run_id\"} == 1) and ((time() - consumer_lag_observed_timestamp_seconds{run_id=\"$run_id\"}) < scalar(max(consumer_lag_freshness_seconds{run_id=\"$run_id\"}))))) and ((count((consumer_lag{run_id=\"$run_id\"} and (consumer_lag_valid{run_id=\"$run_id\"} == 1) and ((time() - consumer_lag_observed_timestamp_seconds{run_id=\"$run_id\"}) < scalar(max(consumer_lag_freshness_seconds{run_id=\"$run_id\"}))))) == max(consumer_expected_partitions{run_id=\"$run_id\"})) and (count(count by (topic, partition) ((consumer_lag{run_id=\"$run_id\"} and (consumer_lag_valid{run_id=\"$run_id\"} == 1) and ((time() - consumer_lag_observed_timestamp_seconds{run_id=\"$run_id\"}) < scalar(max(consumer_lag_freshness_seconds{run_id=\"$run_id\"})))))) == max(consumer_expected_partitions{run_id=\"$run_id\"})))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "System lag skew ratio max divided by mean",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((max((consumer_lag{run_id=\"$run_id\"} and (consumer_lag_valid{run_id=\"$run_id\"} == 1) and ((time() - consumer_lag_observed_timestamp_seconds{run_id=\"$run_id\"}) < scalar(max(consumer_lag_freshness_seconds{run_id=\"$run_id\"}))))) / avg((consumer_lag{run_id=\"$run_id\"} and (consumer_lag_valid{run_id=\"$run_id\"} == 1) and ((time() - consumer_lag_observed_timestamp_seconds{run_id=\"$run_id\"}) < scalar(max(consumer_lag_freshness_seconds{run_id=\"$run_id\"})))))) and (sum((consumer_lag{run_id=\"$run_id\"} and (consumer_lag_valid{run_id=\"$run_id\"} == 1) and ((time() - consumer_lag_observed_timestamp_seconds{run_id=\"$run_id\"}) < scalar(max(consumer_lag_freshness_seconds{run_id=\"$run_id\"}))))) > 0) or (sum((consumer_lag{run_id=\"$run_id\"} and (consumer_lag_valid{run_id=\"$run_id\"} == 1) and ((time() - consumer_lag_observed_timestamp_seconds{run_id=\"$run_id\"}) < scalar(max(consumer_lag_freshness_seconds{run_id=\"$run_id\"}))))) == 0)) and ((count((consumer_lag{run_id=\"$run_id\"} and (consumer_lag_valid{run_id=\"$run_id\"} == 1) and ((time() - consumer_lag_observed_timestamp_seconds{run_id=\"$run_id\"}) < scalar(max(consumer_lag_freshness_seconds{run_id=\"$run_id\"}))))) == max(consumer_expected_partitions{run_id=\"$run_id\"})) and (count(count by (topic, partition) ((consumer_lag{run_id=\"$run_id\"} and (consumer_lag_valid{run_id=\"$run_id\"} == 1) and ((time() - consumer_lag_observed_timestamp_seconds{run_id=\"$run_id\"}) < scalar(max(consumer_lag_freshness_seconds{run_id=\"$run_id\"})))))) == max(consumer_expected_partitions{run_id=\"$run_id\"})))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
