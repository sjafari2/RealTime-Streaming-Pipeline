  CLEANUP_POLICY: "delete"\
  NUM_PARTITIONS: "36"\
  BROKER_COUNT: "5"\
  REPLICATION_FACTOR: "1"\
  MIN_INSYNC_REPLICAS: "1"\
\
  # =============================\
  #  Kafka Producer \
  # =============================\
  PRODUCER_COUNT: "1"\
  PRODUCER_POD_COUNT: "2"\
  PRODUCER_INPUT_PATH: "producer-data"\
  DELAY_BETWEEN_MESSAGES: "0"\
  LINGER_MS: "5"\
  BATCH_SIZE: "262144"\
  COMPRESSION_TYPE: "lz4"\
  MAX_REQUEST_SIZE: "1048576"\
  ACKS: "0"\
  RETRIES: "2"\
  RETRY_BACKOFF_MS: "5"\
  CONNECTION_MAX_IDLE_MS: "30000"\
  RECONNECT_BACKOFF_MS: "100"\
  RECONNECT_BACKOFF_MAX_MS: "1000"\
  RANDOM_RANGE: "1000"\
  REQUEST_TIMEOUT_MS: "10000"\
  DELIVERY_TIMEOUT_MS: "120000"\
  QUEUE_BUFFERING_MAX_MESSAGES: "200000"\
  QUEUE_BUFFERING_MAX_KBYTES: "2097152"\
  CLIENT_ID: "pipeline-producer"\
  MSG_MAX_BYTES: "1048576"\
  METADATA_MAX_AGE_MS: "120000"\
  TOPIC_METADATA_REFRESH_INTERVAL_MS: "120000"\
  MAX_IN_FLIGHT_REQUEST_PER_CONNECTION: "10"\
  TARGET_RATE: "250"\
\
  # =============================\
  #  Kafka Consumer \
  # =============================\
  CONSUMER_GROUP_ID: "consgroup"\
  CONSUMER_COUNT: "1"\
  CONSUMER_POD_COUNT: "12"\
  MAX_MESSAGES: "5000"\
  ENABLE_AUTO_COMMIT: "true"\
  AUTO_OFFSET_RESET: "earliest"\
  AUTO_COMMIT_INTERVAL_MS: "1000"\
  POLL_TIMEOUT: "500"\
  FETCH_MAX_BYTES: "5242880"\
  FETCH_MIN_BYTES: "16384"\
  FETCH_MAX_WAIT_MS: "5"\
  MAX_POLL_RECORDS: "500"\
  MAX_POLL_INTERVAL_MS: "120000"\
  SESSION_TIMEOUT_MS: "20000"\
  HEARTBEAT_INTERVAL_MS: "1000"\
  SOCKET_TIMEOUT_MS: "30000"\
  LAG_QUERY_TIMEOUT: "5.0"\
  LAG_QUERY_INTERVAL: "15"\
  PARTITION_ASSIGNMENT_STRATEGY: "cooperative-sticky"\
  CONSUMER_OUTPUT_DIR: "/app/consumer-merge-data/"\
  PROCESSED_DIR: "/app/consumer-merge-data/processed/" \
  # =============================\
  #  Application\
  # =============================\
  \
  APP_DELAY_MIN_MS: "10"\
  APP_DELAY_MAX_MS: "20"\
  APP_DELAY_MODE: "simulated" \
 \
  # =============================\
  #  Merge\
  # =============================\
 \
  MERGE_OUTPUT_DIR: "/app/merge-result"\
  MERGE_METRICS_DIR: "/app/merge-metrics"\
  MIN_BLOCKS_FOR_GEV: "100"\
